{
  "version": 8,
  "name": "GoWay Satellite · Day",
  "metadata": {
    "goway:style": "satellite",
    "goway:light": "day",
    "goway:appearance": "light",
    "goway:schema": "openmaptiles-v3",
    "goway:anchor:beforeLabels": "goway:anchor:labels",
    "goway:layers": [
      "background",
      "goway:imagery:base",
      "goway:imagery:detail",
      "goway:imagery:fine",
      "goway:anchor:labels"
    ],
    "goway:generator": "packages/frontend/scripts/build-map-style.ts",
    "goway:city3d-ground": [],
    "goway:quality-low": [],
    "goway:imagery": "satellite"
  },
  "light": {
    "anchor": "viewport",
    "position": [
      1.15,
      210,
      30
    ],
    "color": "#ffffff",
    "intensity": 0.2
  },
  "glyphs": "https://goway.to/map/fonts/{fontstack}/{range}.pbf",
  "sprite": "https://goway.to/map/sprites/goway",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://goway.to/map/tiles.json",
      "attribution": "<a href=\"https://www.openmaptiles.org/\" target=\"_blank\">&copy; OpenMapTiles</a> <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\">&copy; OpenStreetMap contributors</a>"
    },
    "goway:imagery:base": {
      "type": "raster",
      "tiles": [
        "https://goway.to/map/satellite/base/{z}/{x}/{y}.webp"
      ],
      "tileSize": 512,
      "minzoom": 0,
      "maxzoom": 13,
      "attribution": "<a href=\"https://goway.to/attribution#imagery\" target=\"_blank\">Imagery: see sources</a>"
    },
    "goway:imagery:detail": {
      "type": "raster",
      "tiles": [
        "https://goway.to/map/satellite/detail/{z}/{x}/{y}.webp"
      ],
      "tileSize": 512,
      "minzoom": 12,
      "maxzoom": 18,
      "attribution": "<a href=\"https://goway.to/attribution#imagery\" target=\"_blank\">Imagery: see sources</a>"
    },
    "goway:imagery:fine": {
      "type": "raster",
      "tiles": [
        "https://goway.to/map/satellite/fine/{z}/{x}/{y}.webp"
      ],
      "tileSize": 512,
      "minzoom": 19,
      "maxzoom": 20,
      "attribution": "<a href=\"https://goway.to/attribution#imagery\" target=\"_blank\">Imagery: see sources</a>"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#0d244f"
      }
    },
    {
      "id": "goway:imagery:base",
      "type": "raster",
      "source": "goway:imagery:base",
      "paint": {
        "raster-fade-duration": 200,
        "raster-resampling": "linear"
      }
    },
    {
      "id": "goway:imagery:detail",
      "type": "raster",
      "source": "goway:imagery:detail",
      "minzoom": 12,
      "paint": {
        "raster-fade-duration": 200,
        "raster-resampling": "linear"
      }
    },
    {
      "id": "goway:imagery:fine",
      "type": "raster",
      "source": "goway:imagery:fine",
      "minzoom": 19,
      "paint": {
        "raster-fade-duration": 200,
        "raster-resampling": "linear"
      }
    },
    {
      "id": "goway:anchor:labels",
      "type": "background",
      "paint": {
        "background-color": "#34445b",
        "background-opacity": 0
      }
    }
  ]
}
