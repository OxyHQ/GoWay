# Oxy client id — the ApplicationCredential publicKey (oxy_dk_…) for GoWay.
# Register an Application + public credential at https://console.oxy.so.
EXPO_PUBLIC_OXY_CLIENT_ID=

# Backend API base URL.
EXPO_PUBLIC_API_URL=https://api.goway.to
# Oxy identity API (sign-in, session restore). Not GoWay's backend.
# EXPO_PUBLIC_OXY_BASE_URL=https://api.oxy.so

# --- Map source (see lib/map/provider.ts) ------------------------------------
# All optional. Unset, GoWay renders its OWN style document
# (public/map/goway-{light,dark}.json) over OpenFreeMap's keyless vector tiles.

# Which registered source to render.
#   goway       GoWay's cartography over OpenFreeMap tiles (default)
#   openfreemap OpenFreeMap's own `liberty`/`fiord` — the escape hatch if a
#               style deploy goes wrong. Note `fiord` has NO poi source-layer,
#               so dark mode loses its basemap POIs under this source.
# EXPO_PUBLIC_MAP_SOURCE=goway

# Origin the origin-RELATIVE style paths resolve against.
#
# Web does not need this: it uses `window.location.origin`, so `expo start
# --web` and every deployment style themselves from their own bundle. NATIVE
# does — an app has no origin — and falls back to https://goway.to, i.e. the
# PRODUCTION style, unless this is set. Point it at the Metro dev server to
# iterate on cartography in a native dev build.
# EXPO_PUBLIC_MAP_STYLE_ORIGIN=http://192.168.1.10:8081

# Override either appearance's MapLibre style document outright. Setting either
# also clears the `beforeLabels` overlay anchor, because the anchor is a promise
# about a document provider.ts has seen.
# EXPO_PUBLIC_MAP_STYLE_URL_LIGHT=
# EXPO_PUBLIC_MAP_STYLE_URL_DARK=

# --- GoWay API data (see lib/goway/client.ts) --------------------------------
# While no GoWay backend is deployed, the app serves `@goway.to/sdk` requests
# from a local fixture layer injected as the SDK's `fetch`. Every request still
# goes through the real client: same query serialisation, same response parser,
# same typed errors. Set to 0 to point the identical app at EXPO_PUBLIC_API_URL.
# EXPO_PUBLIC_GOWAY_FIXTURES=1

# Force endpoint families to fail, so the degraded states can be exercised on
# purpose. Comma-separated `<family>[:<mode>]`, where family is one of
# places | search | geocode | routes | street3d | mercaria and mode is
# unavailable (default) | network | degraded.
#   search:unavailable   -> "Search is unavailable"
#   places:network       -> "You're offline"
#   search:degraded      -> results plus "some sources aren't responding"
#   mercaria             -> a place's products offer "Try again"
# EXPO_PUBLIC_GOWAY_FIXTURE_FAULTS=

# --- Mercaria (see lib/mercaria/client.ts) ------------------------------------
# Mercaria's public API, where a place's "Products at this store" is read from.
# Anonymous reads only. Unset, the SDK's own default. With fixtures on, the
# Mercaria fixture layer answers instead and this is not contacted.
# EXPO_PUBLIC_MERCARIA_API_URL=https://api.mercaria.co

# --- Street 3D (see docs/STREET3D_VIEWER.md) ----------------------------------
# Street 3D VIEWING: the coverage layer on the map and /street3d/<id>. Off unless
# 1/true. A coverage endpoint answering 404/503 hides the layer silently anyway.
# EXPO_PUBLIC_STREET3D_ENABLED=0

# Origin published scene assets are served from. When set, the viewer refuses
# asset URLs on any other origin. Build-time; `public/_headers` sets no CSP today,
# but if one is added it must allow this origin in connect-src and img-src, and
# blob: in worker-src.
# EXPO_PUBLIC_STREET3D_ASSET_ORIGIN=

# Public web origin of this deployment. Native only: the native Street 3D screen
# hosts <WEB_ORIGIN>/street3d/<id>?embed=1 in a WebView. Defaults to https://goway.to.
# EXPO_PUBLIC_WEB_ORIGIN=

# Fixture scene assets (fixtures on). No sample splat is committed: point these
# at a .spz you are entitled to use, served over HTTPS (the SDK rejects other
# asset URLs) with CORS. Unset, the URLs are on the
# reserved .invalid TLD and the viewer shows its load-failure state.
# EXPO_PUBLIC_STREET3D_FIXTURE_SPLAT_URL=
# EXPO_PUBLIC_STREET3D_FIXTURE_PREVIEW_URL=
# EXPO_PUBLIC_STREET3D_FIXTURE_POSTER_URL=
# EXPO_PUBLIC_STREET3D_FIXTURE_ANCHOR=lat,lng,altitude
# EXPO_PUBLIC_STREET3D_FIXTURE_VIEW=px,py,pz,tx,ty,tz
# EXPO_PUBLIC_STREET3D_FIXTURE_ATTRIBUTION=
# A JSON file in the manifest's `navigation` shape ({ viewpoints, fieldOfView }),
# fetched by the app (CORS for the dev origin) and attached to the first fixture
# scene. Turns on guided Walk navigation in the viewer.
# EXPO_PUBLIC_STREET3D_FIXTURE_NAVIGATION_URL=
