# GoWay app configuration. Build-time: Expo inlines every EXPO_PUBLIC_* value.
# Only what differs per deployment lives here — ids and the origins the app
# talks to. Map features (globe, terrain, Street 3D, the 3D city, …) have no
# variable: a person turns them on or off in the map's settings
# (docs/MAP_FEATURES.md).

# Oxy client id: the ApplicationCredential publicKey (oxy_dk_…) registered at
# https://console.oxy.so. Unset, the app works signed out and sign-in is off.
EXPO_PUBLIC_OXY_CLIENT_ID=
# GoWay's API (unset: https://api.goway.to).
EXPO_PUBLIC_API_URL=https://api.goway.to
# Oxy's identity API, for sign-in and session restore (unset: https://api.oxy.so).
# EXPO_PUBLIC_OXY_BASE_URL=https://api.oxy.so
# Mercaria's public API, for a place's products (unset: the SDK's own origin).
# EXPO_PUBLIC_MERCARIA_API_URL=https://api.mercaria.co
# Native only: the web origin whose /street3d/<id> the native viewer embeds
# (unset: https://goway.to).
# EXPO_PUBLIC_WEB_ORIGIN=
# The only origin Street 3D scene assets may come from (unset: any https asset
# the API returns). A CSP added to public/_headers must allow it.
# EXPO_PUBLIC_STREET3D_ASSET_ORIGIN=

# ── Map source overrides (lib/map/provider.ts; unset in production) ─────────
# `openfreemap` is the escape hatch to OpenFreeMap's own styles (unset: goway).
# EXPO_PUBLIC_MAP_SOURCE=goway
# Either appearance's style document, outright.
# EXPO_PUBLIC_MAP_STYLE_URL_LIGHT=
# EXPO_PUBLIC_MAP_STYLE_URL_DARK=
# The elevation tile template (unset: https://goway.to/map/terrain/{z}/{x}/{y}.webp).
# EXPO_PUBLIC_MAP_TERRAIN_TILES=

# ── Development only ────────────────────────────────────────────────────────
# Native dev builds: the origin the relative style paths resolve against, e.g.
# the Metro dev server, to iterate on cartography (unset: https://goway.to).
# EXPO_PUBLIC_MAP_STYLE_ORIGIN=http://192.168.1.10:8081
#
# The fixture layer (lib/goway/client.ts) answers the SDK locally in a
# development build, so it runs with no backend; a production build never uses
# it unless this says 1. Set 0 to point a development build at
# EXPO_PUBLIC_API_URL. Directions are never a fixture (README → "Directions in
# development").
# EXPO_PUBLIC_GOWAY_FIXTURES=0
# Force fixture families to fail: comma-separated <family>[:<mode>], family one
# of places|search|geocode|routes|street3d|mercaria, mode
# unavailable (default)|network|degraded. E.g. search:degraded,places:network.
# EXPO_PUBLIC_GOWAY_FIXTURE_FAULTS=
#
# Street 3D fixture scenes (fixtures on; docs/STREET3D_VIEWER.md). No sample
# splat is committed: point these at a .spz or .rad you may use, served over
# HTTPS with CORS. Unset, the viewer shows its load-failure state.
# EXPO_PUBLIC_STREET3D_FIXTURE_SPLAT_URL=
# EXPO_PUBLIC_STREET3D_FIXTURE_PREVIEW_URL=
# EXPO_PUBLIC_STREET3D_FIXTURE_POSTER_URL=
# EXPO_PUBLIC_STREET3D_FIXTURE_ANCHOR=lat,lng,altitude
# EXPO_PUBLIC_STREET3D_FIXTURE_VIEW=px,py,pz,tx,ty,tz
# EXPO_PUBLIC_STREET3D_FIXTURE_ATTRIBUTION=
# A JSON file in the manifest's `navigation` shape, attached to the first
# fixture scene: turns on guided Walk navigation.
# EXPO_PUBLIC_STREET3D_FIXTURE_NAVIGATION_URL=
# A second .rad drawn behind the splat, and the scene's enuFromScene (16
# column-major numbers; identity when unset).
# EXPO_PUBLIC_STREET3D_FIXTURE_ENVIRONMENT_URL=
# EXPO_PUBLIC_STREET3D_FIXTURE_TRANSFORM=
