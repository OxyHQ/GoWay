{
  "extends": "@oxy.so/app-preset/tsconfig/frontend.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    // The PMTiles reader is plain JS because it is deployed INSIDE the Worker
    // bundle, which has no TypeScript step. `scripts/build-map-tiles.ts`
    // imports it anyway — deliberately, so that the build-time verifier reads
    // a finished archive with exactly the code the edge serves it with — and a
    // file a program imports has to be in that program.
    "worker/pmtiles.js",
    "worker/coverageTree.js",
    // The satellite manifest builder checks what it writes with the Worker's
    // own parser (`scripts/build-satellite-manifest.ts`), which reads its
    // archives with the city route's byte source.
    "worker/satellite.js",
    "worker/city.js",
    "worker/tiles.js",
    "worker/budget.js",
    // The contour maker, likewise: `scripts/serve-map-build.ts` runs the
    // edge's own module so a local export draws the contours goway.to will.
    "worker/contours.js",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": ["node_modules", "dist", ".expo"]
}
