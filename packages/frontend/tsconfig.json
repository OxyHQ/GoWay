{
  "extends": "@oxy.so/app-preset/tsconfig/frontend.json",
  "compilerOptions": {
    "types": ["bun"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    // The dev servers' Metro hooks are plain JS, imported by their tests.
    "scripts/dev-city-tiles.js",
    "scripts/dev-terrain.js",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": ["node_modules", "dist", ".expo"]
}
