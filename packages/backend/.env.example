# Backend runtime configuration for GoWay.
#
# Every variable below is parsed ONCE, by zod, in src/config/index.ts. A value
# that does not parse fails the process at load rather than at the first request
# that happens to read it.

PORT=3000
NODE_ENV=development

# PostgreSQL + PostGIS connection string. Required — the server refuses to start
# without it. `docker compose -f ../../docker-compose.postgres.yml up -d --wait postgres`
# brings up a local server matching the value below.
#
# Port 5440 is GoWay's. 5432-5439 and 5441 belong to other Oxy backends' local
# databases (5439 is Peable's, 5441 is Schedio's), and a collision silently
# connects you to one of them.
DATABASE_URL=postgres://goway:goway@127.0.0.1:5440/goway_dev

# Where the real-database test suites create their throwaway databases. Only the
# SERVER in this URL is used — each `*.realdb.test.ts` file creates, migrates and
# drops its own `oxydb_test_*` database on it, and the database named here is
# never touched. Unset, the suites fall back to DATABASE_URL's server (which is
# what CI does); with neither reachable they FAIL rather than skip, because a
# skipped spatial suite is the same colour as a passing one.
# TEST_DATABASE_URL=postgres://goway:goway@127.0.0.1:5440/goway_dev

# Connection pool (optional; the values below are the defaults the code uses).
# DATABASE_POOL_MAX=10
# DATABASE_IDLE_TIMEOUT_SECONDS=30
# DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Extra browser origins allowed through CORS, comma separated. The HTTPS oxy.so
# apex family and goway.to are allowed by @oxy.so/core's createOxyCors already,
# so this is for the Expo dev server and nothing else.
CORS_APP_ORIGINS=http://localhost:8081,http://localhost:19006

# Oxy identity API. Leave unset outside a local Oxy stack.
# OXY_API_URL=https://api.oxy.so

# pino level: silent|trace|debug|info|warn|error|fatal. Defaults to debug outside
# production and info in it.
# LOG_LEVEL=debug

# ── Routing (issue #6) ──────────────────────────────────────────────────────
#
# Every variable below is optional and is parsed in src/config/routing.ts,
# separately from the block above. Leaving ROUTING_VALHALLA_URL unset is a
# supported state: POST /api/v1/routes then answers `service_unavailable` and
# the rest of the API is unaffected. The map, Places and search do not need a
# routing engine.

# The FULL route endpoint of a Valhalla server, not an origin. A stock Valhalla
# answers POST /route at its root; a hosted one puts the engine under a prefix
# of its own, so the complete URL is what is configured.
#
# There is deliberately no default. A public community Valhalla instance is
# usable for LOCAL DEVELOPMENT by uncommenting the line below — it is rate
# limited under a fair-use policy, it is NOT an SLA-backed production
# dependency, and consumer applications must never be pointed at it. Production
# runs its own deployment.
# ROUTING_VALHALLA_URL=https://valhalla1.openstreetmap.de/route

# Sent as the `api_key` query parameter, for a hosted Valhalla that needs one.
# It lives here rather than inside the URL so it never appears in a logged URL.
# ROUTING_VALHALLA_API_KEY=

# Which engine drives the RoutingProvider interface. `valhalla` is the only one
# implemented; the variable exists so a second adapter is a configuration change.
# ROUTING_PROVIDER=valhalla

# How long ONE upstream routing call may take, in milliseconds (250..60000).
# Kept under @goway.to/sdk's own 15 s budget so a slow engine surfaces as
# `provider_unavailable`, which a client can act on, rather than as the SDK's
# timeout, which tells the caller nothing about who was slow. One attempt, no
# retries: a directions request is interactive.
# ROUTING_TIMEOUT_MS=10000

# Travel modes this deployment offers, comma separated, from drive,walk,bike.
# Narrow it when the tiles were built without a costing model — a caller then
# gets `unsupported_mode`, which is something a client can hide a button for,
# instead of an engine error they cannot interpret.
# ROUTING_MODES=drive,walk,bike

# Alternative routes requested when a caller asks for them (0..5; 0 switches
# alternatives off).
# ROUTING_MAX_ALTERNATIVES=2

# How GoWay identifies itself to the routing engine. Community-run map services
# ask callers to identify themselves so abuse is traceable to a project rather
# than to an IP range.
# ROUTING_USER_AGENT=GoWay/1.0 (+https://goway.to)
