# GoWay backend configuration. Only what differs per deployment lives here:
# where things are (databases, origins, engines, buckets, queues) and who may do
# what. Features have no on/off switches — a feature that needs infrastructure
# runs when that infrastructure is configured — and tuning (timeouts, limits,
# thresholds, retention) is code (src/config/*.ts), reviewed like code.
# Every value is parsed at startup by zod; a malformed one stops the process.

# ── Core ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# PostgreSQL + PostGIS. Required. Port 5440 is GoWay's local one (README).
DATABASE_URL=postgres://goway:goway@127.0.0.1:5440/goway_dev
# Browser origins on the credentialed CORS lane, comma separated (GoWay's and
# Mercaria's apps; createOxyCors already allows the oxy.so family).
CORS_APP_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:8160,http://localhost:8161
# Oxy user ids that may use /api/v1/moderation. Empty: nobody moderates.
# MODERATION_OPERATOR_OXY_USER_IDS=
# Oxy identity API. Leave unset outside a local Oxy stack.
# OXY_API_URL=https://api.oxy.so
# pino level; a variable so an incident can raise it without a release.
# Defaults to debug outside production, info in it.
# LOG_LEVEL=debug
# AWS region of the buckets and queues below.
# AWS_REGION=us-west-2

# ── Routing ─────────────────────────────────────────────────────────────────
# The FULL route endpoint of a Valhalla server. Unset: POST /routes answers
# service_unavailable. Locally, run GoWay's own engine
# (packages/routing-engine/README.md → "Running it locally"); the public
# community instance (https://valhalla1.openstreetmap.de/route) is a fair-use
# fallback for one developer, never more.
# ROUTING_VALHALLA_URL=http://127.0.0.1:8002/route
# Key for a hosted Valhalla that needs one (sent as api_key, never in the URL).
# ROUTING_VALHALLA_API_KEY=

# ── Search ──────────────────────────────────────────────────────────────────
# Photon base URL. Unset: the community instance, within its fair-use policy.
# SEARCH_PHOTON_BASE_URL=https://photon.komoot.io
# Languages that Photon instance was built with (unset: de,en,fr,it).
# SEARCH_PHOTON_LANGUAGES=de,en,fr,it
# A Nominatim instance turns on Nominatim for explicit geocoding (never the
# search box). Unset: Photon alone.
# SEARCH_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Operator contact sent to Nominatim, as its usage policy asks.
# SEARCH_NOMINATIM_EMAIL=

# ── Street 3D capture ───────────────────────────────────────────────────────
# The temporary bucket contributions are uploaded to. Unset: contribution
# answers service_unavailable; nothing else changes.
# CAPTURE_S3_BUCKET=
# Its region, when not AWS_REGION.
# CAPTURE_S3_REGION=
# Closed pilot: only these Oxy user ids may contribute. Unset: every account.
# CAPTURE_PILOT_OXY_USER_IDS=

# ── Street 3D reconstruction (docs/STREET3D_PIPELINE.md) ────────────────────
# The pipeline — and its in-process scheduler — runs when both queues, the
# scene bucket, its public origin and the capture bucket are all set. Viewing
# published scenes needs none of it and is always on.
# STREET3D_JOBS_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account>/goway-street3d-jobs
# STREET3D_EVENTS_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account>/goway-street3d-events
# The jobs queue's dead-letter queue, for `street3d:admin status`.
# STREET3D_JOBS_DLQ_URL=
# The public scene bucket, the origin it is served from, and the CloudFront
# distribution invalidated when a version is disabled.
# STREET3D_SCENE_BUCKET=
# STREET3D_PUBLIC_ASSET_BASE_URL=https://<cdn-origin>
# STREET3D_CDN_DISTRIBUTION_ID=

# ── GoWay Live (docs/MAP_LIVE.md) ───────────────────────────────────────────
# Live runs when this lists a source, each opted into by id after its licence
# review (src/live/catalogue.ts). Unset: no poller, no /live namespace.
# LIVE_SOURCES=adsb-lol,renfe-cercanias,fgc-geotren,mta-bus,mta-lirr,mta-mnr,nyc-bikeshare,digitraffic-ais
# Per-source endpoint override and key, <ID> upper-cased with - as _:
# LIVE_SOURCE_<ID>_URL / LIVE_SOURCE_<ID>_KEY.
# LIVE_SOURCE_ADSB_LOL_URL=https://api.adsb.lol

# ── Development only ────────────────────────────────────────────────────────
# Where the *.realdb.test.ts suites create their throwaway databases (only the
# server is used). Unset: DATABASE_URL's server.
# TEST_DATABASE_URL=postgres://goway:goway@127.0.0.1:5440/goway_dev
# A local S3-compatible store (MinIO) for captures, and local emulators for
# the Street 3D queues and scene bucket.
# CAPTURE_S3_ENDPOINT=http://127.0.0.1:9000
# STREET3D_SQS_ENDPOINT=
# STREET3D_SCENE_S3_ENDPOINT=
# A local directory standing in for the scene bucket (never beside
# STREET3D_SCENE_BUCKET): `street3d:admin import-licensed` writes there and
# `bun run street3d:serve-assets` serves it at STREET3D_PUBLIC_ASSET_BASE_URL.
# STREET3D_SCENE_LOCAL_DIR=../../.street3d-scenes
# STREET3D_PUBLIC_ASSET_BASE_URL=http://127.0.0.1:8790
