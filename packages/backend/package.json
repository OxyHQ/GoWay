{
  "name": "@goway/backend",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "bun --watch server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "bun dist/server.js",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "test": "bun test",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "import:osm": "bun run src/import/osm/run.ts"
  },
  "dependencies": {
    "@goway/shared-types": "workspace:*",
    "@oxy.so/core": "^1.16.0",
    "@oxy.so/db": "^1.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "drizzle-orm": "0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "postgres": "3.4.9",
    "socket.io": "^4.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bun": "^1.4.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "typescript": "^5.9.3"
  }
}
