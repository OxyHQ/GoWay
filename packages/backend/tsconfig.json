{
  "extends": "@oxy.so/app-preset/tsconfig/backend.json",
  "compilerOptions": {
    // Restated rather than inherited. `strict` comes from the preset today, and
    // a preset is a dependency: a future version that relaxes it would silently
    // relax this package. Stating it here means that change shows up as a
    // conflict to resolve instead of as type errors that stop being reported.
    "strict": true,
    "rootDir": "./",
    "outDir": "dist",
    // No `paths` mapping to ../contracts/src on purpose. This is an EMITTING
    // project with `rootDir: "./"`, so pulling another package's SOURCE into the
    // program puts files outside rootDir and fails with TS6059. The project
    // reference below is the supported mechanism: contracts builds first and
    // this package resolves it through node_modules to its emitted .d.ts.
    //
    // `module: commonjs` with `moduleResolution` cleared (null), not the
    // preset's `node` (node10, removed in TypeScript 7 and so rejected by
    // `bun check`). tsc 5.9 then defaults to node10 exactly as before, and
    // TypeScript 7 picks its own default. Node16 is NOT used here: it keeps a
    // dynamic `import()` as a real `import()` instead of `require()`, which
    // would change the emitted dist/src/import/osm/run.js that production
    // runs and switch its `@oxy.so/db/migrate` import to the ESM build.
    "module": "commonjs",
    "moduleResolution": null,
    // `bun check` does not load every @types package the way tsc does, so the
    // ambient types this Bun-run service uses are listed.
    "types": ["bun", "node"],
    // TypeScript 7's default, stated so tsc 5.9 reports an unresolvable
    // side-effect import (`import 'x'`) the same way `bun check` does.
    "noUncheckedSideEffectImports": true
  },
  "include": ["**/*.ts"],
  // drizzle.config.ts is excluded from the EMITTING build on purpose. It imports
  // `drizzle-kit`, a devDependency the runtime image strips
  // (`bun install --production` in the Dockerfile), so compiling it puts a module
  // into dist/ whose first `require` throws in production. Nothing requires it
  // today, which is exactly what makes it worth excluding now rather than after
  // something does. drizzle-kit loads and type-checks the config itself when
  // `db:generate` runs, which is the only place it is ever used.
  //
  // `**/__tests__/**` is excluded from the EMITTING build for the same class of
  // reason: the runtime image copies dist/, and a compiled test file there is
  // dead weight that imports devDependencies `bun install --production` strips.
  // It is NOT left unchecked — tsconfig.tools.json puts it in a non-emitting
  // program, because a file outside every `include` can never report an error.
  "exclude": ["node_modules", "dist", "drizzle.config.ts", "**/__tests__/**"],
  "references": [{ "path": "../contracts" }]
}
