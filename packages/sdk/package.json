{
  "name": "@goway.to/sdk",
  "version": "0.7.0",
  "description": "The canonical, headless TypeScript client for GoWay's public geographic API — Places, capability filters, search, geocoding, routing, typed errors and canonical links for Node, Bun, browsers and React Native.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "The Oxy Collective, Inc.",
  "homepage": "https://github.com/OxyHQ/GoWay/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OxyHQ/GoWay.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/OxyHQ/GoWay/issues"
  },
  "keywords": [
    "goway",
    "oxy",
    "maps",
    "places",
    "geocoding",
    "routing",
    "geospatial",
    "sdk",
    "api-client"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./live": {
      "react-native": {
        "types": "./dist/live.d.ts",
        "default": "./dist/live.js"
      },
      "import": {
        "types": "./dist/live.d.ts",
        "default": "./dist/live.js"
      },
      "require": {
        "types": "./dist/live.d.cts",
        "default": "./dist/live.cjs"
      },
      "default": {
        "types": "./dist/live.d.ts",
        "default": "./dist/live.js"
      }
    },
    "./geo": {
      "react-native": {
        "types": "./dist/geo.d.ts",
        "default": "./dist/geo.js"
      },
      "import": {
        "types": "./dist/geo.d.ts",
        "default": "./dist/geo.js"
      },
      "require": {
        "types": "./dist/geo.d.cts",
        "default": "./dist/geo.cjs"
      },
      "default": {
        "types": "./dist/geo.d.ts",
        "default": "./dist/geo.js"
      }
    },
    "./road-access": {
      "react-native": {
        "types": "./dist/roadAccess.d.ts",
        "default": "./dist/roadAccess.js"
      },
      "import": {
        "types": "./dist/roadAccess.d.ts",
        "default": "./dist/roadAccess.js"
      },
      "require": {
        "types": "./dist/roadAccess.d.cts",
        "default": "./dist/roadAccess.cjs"
      },
      "default": {
        "types": "./dist/roadAccess.d.ts",
        "default": "./dist/roadAccess.js"
      }
    },
    "./map": {
      "react-native": {
        "types": "./dist/map.d.ts",
        "default": "./dist/map.js"
      },
      "import": {
        "types": "./dist/map.d.ts",
        "default": "./dist/map.js"
      },
      "require": {
        "types": "./dist/map.d.cts",
        "default": "./dist/map.cjs"
      },
      "default": {
        "types": "./dist/map.d.ts",
        "default": "./dist/map.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "rm -rf dist",
    "typecheck": "bun check -p tsconfig.json && bun check -p tsconfig.test.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build",
    "release:pack": "node scripts/smoke.mjs --out"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@goway/contracts": "workspace:*",
    "esbuild": "^0.25.12",
    "rollup": "^4.59.0",
    "rollup-plugin-dts": "~6.4.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
