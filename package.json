{
  "name": "goway",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "GoWay — Oxy's open map and geographic platform",
  "workspaces": [
    "packages/contracts",
    "packages/sdk",
    "packages/maps",
    "packages/map-service",
    "packages/frontend",
    "packages/backend"
  ],
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun run --cwd packages/backend dev & bun run --cwd packages/frontend start",
    "dev:frontend": "bun run --cwd packages/frontend start",
    "dev:backend": "bun run --cwd packages/backend dev",
    "build": "bun run build:contracts && bun run build:sdk && bun run build:maps && bun run build:backend && bun run build:frontend",
    "build:contracts": "bun run --cwd packages/contracts build",
    "build:sdk": "bun run --cwd packages/sdk build",
    "build:maps": "bun run --cwd packages/maps build",
    "build:frontend": "bun run --cwd packages/frontend export:web",
    "build:backend": "bun run --cwd packages/backend build",
    "web": "bun run --cwd packages/frontend web",
    "android": "bun run --cwd packages/frontend android",
    "ios": "bun run --cwd packages/frontend ios",
    "lint": "biome check . && bun run lint:frontend",
    "typecheck": "bun check -b && bun check -p packages/backend/tsconfig.tools.json && bun run --cwd packages/frontend typecheck && bun run --cwd packages/sdk typecheck && bun run --cwd packages/maps typecheck",
    "test": "bun run --cwd packages/backend test && bun run --cwd packages/sdk test && bun run test:maps && bun run test:map-service && bun run test:frontend",
    "doctor:oxy": "oxy-doctor --ci",
    "db:generate": "bun run --cwd packages/backend db:generate",
    "db:migrate": "bun run --cwd packages/backend db:migrate",
    "import:osm": "bun run --cwd packages/backend import:osm",
    "places:convert-legacy": "bun run --cwd packages/backend places:convert-legacy",
    "categories:move": "bun run --cwd packages/backend categories:move",
    "captures:cleanup": "bun run --cwd packages/backend captures:cleanup",
    "street3d:tick": "bun run --cwd packages/backend street3d:tick",
    "street3d:admin": "bun run --cwd packages/backend street3d:admin",
    "street3d:serve-assets": "bun run --cwd packages/backend street3d:serve-assets",
    "oxy-references:admin": "bun run --cwd packages/backend oxy-references:admin",
    "worker:setup": "make -C packages/reconstruction-worker setup",
    "worker:doctor": "make -C packages/reconstruction-worker doctor",
    "worker:run": "make -C packages/reconstruction-worker run",
    "worker:bench": "make -C packages/reconstruction-worker bench",
    "validate:agents-md": "bun ./scripts/check-agents-md-size.mjs && bun ./scripts/test-check-agents-md-size.mjs",
    "clean": "bun run --cwd packages/contracts clean && bun run --cwd packages/sdk clean && bun run --cwd packages/backend clean",
    "postinstall": "bun run build:contracts && bun run build:sdk && bun run build:maps",
    "lint:frontend": "bun run --cwd packages/frontend lint",
    "test:backend": "bun run --cwd packages/backend test",
    "test:frontend": "bun run --cwd packages/frontend test",
    "check:lockfile": "bun ./scripts/check-lockfile-sync.mjs",
    "check:migrations": "bun ./scripts/check-migration-phases.mjs && bun ./scripts/check-migration-params.mjs && bun run check:migration-locks",
    "check:migration-locks": "oxy-db-check-migration-locks --migrations=packages/backend/drizzle --after=25 --hot-tables=places,places_names,places_sources",
    "check:routing": "bun ./scripts/check-routing.mjs",
    "check:road-rules": "bun ./scripts/check-road-rules.mjs",
    "check:openapi": "bun ./scripts/check-openapi-fresh.mjs",
    "check:contracts": "bun ./scripts/check-contract-json-schemas.mjs",
    "check:docs": "bun ./scripts/check-developer-docs.mjs && bun ./scripts/write-api-docs.mjs --check && bun ./scripts/check-docs-examples.mjs",
    "openapi": "bun ./scripts/write-openapi.mjs",
    "test:gates": "bun ./scripts/test-check-routing.mjs && bun ./scripts/test-check-road-rules.mjs && bun ./scripts/test-check-migration-phases.mjs && bun ./scripts/test-check-migration-params.mjs && bun ./scripts/test-check-openapi-fresh.mjs && bun ./scripts/test-check-contract-json-schemas.mjs && bun ./scripts/test-check-developer-docs.mjs",
    "test:gates:lockfile": "bun ./scripts/test-check-lockfile-sync.mjs",
    "test:sdk": "bun run --cwd packages/sdk test",
    "test:maps": "bun run --cwd packages/maps test",
    "test:map-service": "bun run --cwd packages/map-service test",
    "smoke:sdk": "bun run --cwd packages/sdk smoke",
    "check:dockerfile": "bun ./scripts/check-dockerfile-workspaces.mjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@oxy.so/doctor": "1.2.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@oxy.so/core": "^6.9.1",
    "@oxy.so/contracts": "5.4.0",
    "@oxy.so/bloom": "15.0.0",
    "@oxy.so/protocol": "1.4.1",
    "@oxy.so/services": "12.4.0",
    "lightningcss": "1.30.1",
    "react-native-css": "3.1.0-rc.0",
    "expo-modules-core": "58.0.23"
  },
  "resolutions": {
    "@oxy.so/core": "^6.9.1",
    "@oxy.so/contracts": "5.4.0",
    "@oxy.so/bloom": "15.0.0",
    "lightningcss": "1.30.1",
    "react-native-css": "3.1.0-rc.0",
    "expo-modules-core": "58.0.23"
  }
}
