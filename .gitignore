# Dependencies
node_modules/

# Build output. Deliberately NOT a bare `lib/`: the frontend template ships
# `packages/frontend/lib` (config, queryClient, themePersistence, i18n) and that
# pattern would ignore it, so a generated app's first commit would silently omit
# every module behind the `@/lib/*` alias. `shared-types` builds to `dist/`.
dist/
web-build/

# Expo
.expo/
.expo-shared/
*.orig.*
expo-env.d.ts.bak

# Native
/ios/
/android/

# Env
.env
.env.local
.env*.local

# Logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# Misc
.DS_Store
*.tsbuildinfo
.turbo/

# Third-party Apple Maps screenshots, kept only as a colour reference while
# GoWay's own cartography is matched against them. They are somebody else's
# rendering of somebody else's data: useful to sample, never ours to
# redistribute, and worthless to a future reader once the hexes they produced
# are recorded in `lib/map/style/palette.ts` with their provenance.
.apple-maps-reference/
